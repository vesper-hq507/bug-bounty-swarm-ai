# README animation — adaptive attack-path scoring.
# Regenerate with:  vhs docs/adaptive-scoring.tape
Output docs/adaptive-scoring.gif

Set Shell "zsh"
Set FontFamily "JetBrains Mono"
Set FontSize 18
Set Width 1960
Set Height 1080
Set TypingSpeed 28ms
# VHS collapses idle-frame delays during the script's sleeps, so slow playback
# back to a readable, real-time tempo.
Set PlaybackSpeed 0.5
Set WindowBar Colorful
Set Margin 44
Set MarginFill "#7F77DD"
Set BorderRadius 14
Set LineHeight 1.2

Set Theme { "background": "#0B0E14", "foreground": "#E6E9EF", "cursor": "#F5A623", "selection": "#20293a", "black": "#0B0E14", "red": "#ff6b6b", "green": "#3DDC97", "yellow": "#F5A623", "blue": "#7F77DD", "magenta": "#AFA9EC", "cyan": "#57C7FF", "white": "#E6E9EF", "brightBlack": "#5C6577", "brightRed": "#FF8787", "brightGreen": "#5EF0B0", "brightYellow": "#FFC04D", "brightBlue": "#9A92E8", "brightMagenta": "#C9C4F5", "brightCyan": "#7FD8FF", "brightWhite": "#FFFFFF" }

Hide
Type `clear`
Enter
Show
Type "bash docs/adaptive-scoring.sh"
Sleep 400ms
Enter
Sleep 22s
